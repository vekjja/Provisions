# ZSH

# Source all .zshrc-* files
for file in ~/.zshrc-*; do
  [ -e "$file" ] && source "$file"
done

if [ -f ~/.apks ]; then
  source ~/.apks
fi


## Go
export GOROOT=/usr/local/go


## Aliases
alias du=gdu
alias f=ranger

alias desktop-mouse="input-remapper-control --command start --device 'Razer Razer Naga V2 HyperSpeed' --preset 'Desktop'"
alias gaming-mouse="input-remapper-control --command stop --device 'Razer Razer Naga V2 HyperSpeed' --preset 'Desktop'"
