Include ~/.ssh/*.ssh.config

Host mini-cloud
    User cloudmin
    Hostname 10.0.0.10

Host pi-gadget
    # Hostname 100.0.0.10
    User admin
    ForwardAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/livingroom.cloud.key

