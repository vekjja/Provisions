{
    "apiVersion": 1,
    "groups": [
        {
            "orgId": 1,
            "name": "Pod Metrics",
            "folder": "infra-alerts",
            "interval": "10s",
            "rules": [
                {
                    "uid": "cfpqdhfcupam8d",
                    "title": "Pod CPU Usage > 10%",
                    "condition": "B",
                    "data": [
                        {
                            "refId": "Pod CPU Usage",
                            "relativeTimeRange": {
                                "from": 300,
                                "to": 0
                            },
                            "datasourceUid": "P1809F7CD0C75ACF3",
                            "model": {
                                "datasource": {
                                    "type": "prometheus",
                                    "uid": "P1809F7CD0C75ACF3"
                                },
                                "editorMode": "code",
                                "expr": "100 *\navg by (namespace, pod, container, node) (\n  rate(container_cpu_usage_seconds_total{\n    pod=~\".+\",\n    container=~\".+\",\n    container!=\"POD\",\n    image=~\".+\"\n  }[$__rate_interval])\n)\n/\non (node) group_left\nmax by (node) (machine_cpu_cores)",
                                "instant": false,
                                "interval": "",
                                "intervalMs": 15000,
                                "legendFormat": "{{namespace}}: {{container}}",
                                "maxDataPoints": 43200,
                                "range": true,
                                "refId": "Pod CPU Usage"
                            }
                        },
                        {
                            "refId": "A",
                            "queryType": "expression",
                            "relativeTimeRange": {
                                "from": 0,
                                "to": 0
                            },
                            "datasourceUid": "__expr__",
